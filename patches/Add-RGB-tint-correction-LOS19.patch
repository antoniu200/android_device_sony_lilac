+
+using ::android::hardware::hidl_string;
+using ::android::hardware::hidl_vec;
+using ::android::hardware::Return;
+
+class DisplayColorCalibration : public IDisplayColorCalibration {
+  public:
+    DisplayColorCalibration(std::shared_ptr<SDMController> controller,
+                            bool factory_correction_supported);
+
+    static bool isSupported(const hidl_string& name = "default");
+
+    Return<int32_t> getMaxValue() override;
