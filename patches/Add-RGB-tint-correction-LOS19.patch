diff --git a/sdm/DisplayColorCalibration.cpp b/sdm/DisplayColorCalibration.cpp
new file mode 100644
index 0000000..b336142
--- /dev/null
+++ b/sdm/DisplayColorCalibration.cpp
@@ -0,0 +1,215 @@
+#ifdef LIVES_IN_SYSTEM
+#define LOG_TAG "lineage.livedisplay@2.0-impl-sdm"
+#else
+#define LOG_TAG "vendor.lineage.livedisplay@2.0-impl-sdm"
+#endif
+
+#include "livedisplay/sdm/DisplayColorCalibration.h"
+
+#include <android-base/logging.h>
+#include <android/hidl/manager/1.0/IServiceManager.h>
+#include <hidl/ServiceManagement.h>
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <utility>
+
+namespace {
+
+constexpr int32_t kProfessionalMode = 100;
+constexpr int32_t kStandardMode = 101;
+constexpr int32_t kVividMode = 102;
+
+const char* FactoryCorrectionPath(int32_t mode_id) {
+    switch (mode_id) {
+        case kProfessionalMode:
+            return "/sys/devices/mdss_dsi_panel/srgb_cc";
+        case kStandardMode:
+            return "/sys/devices/mdss_dsi_panel/cc";
+        case kVividMode:
+            return "/sys/devices/mdss_dsi_panel/vivid_cc";
+        default:
+            return nullptr;
+    }
+}
+
+double DecodeFactoryCoefficient(uint32_t raw) {
+    if (raw == 0) {
+        return 1.0;
+    }
+    return static_cast<double>(raw & 0x7fffU) / 32768.0 +
+           static_cast<double>((raw >> 15) & 0x3U);
+}
+
+bool ParseFactoryCorrection(const char* path, std::array<double, 3>* rgb) {
+    std::ifstream stream(path);
+    if (!stream.is_open()) {
+        PLOG(ERROR) << "Unable to open factory PCC source " << path;
+        return false;
+    }
+
+    std::string data;
+    std::getline(stream, data);
+    std::replace(data.begin(), data.end(), ',', ' ');
+    std::replace(data.begin(), data.end(), ';', ' ');
+    std::replace(data.begin(), data.end(), '/', ' ');
+
+    std::istringstream parser(data);
+    std::array<uint32_t, 3> raw{};
+    parser >> std::hex >> raw[0] >> raw[1] >> raw[2];
+    if (parser.fail()) {
+        LOG(ERROR) << "Unable to parse factory PCC source " << path << ": " << data;
+        return false;
+    }
+
+    for (size_t i = 0; i < raw.size(); i++) {
+        if (raw[i] > 0x1ffffU) {
+            LOG(ERROR) << "Factory PCC coefficient out of range in " << path;
+            return false;
+        }
+        (*rgb)[i] = DecodeFactoryCoefficient(raw[i]);
+    }
+
+    return true;
+}
+
+}  // anonymous namespace
+
+namespace vendor {
+namespace lineage {
+namespace livedisplay {
+namespace V2_0 {
+namespace sdm {
+
+using ::android::OK;
+using ::android::hardware::Void;
+
+DisplayColorCalibration::DisplayColorCalibration(std::shared_ptr<SDMController> controller,
+                                                 bool factory_correction_supported)
+    : controller_(std::move(controller)),
+      factory_correction_supported_(factory_correction_supported),
+      factory_correction_enabled_(factory_correction_supported) {}
+
+bool DisplayColorCalibration::isSupported(const hidl_string& name) {
+    using ::android::hidl::manager::V1_0::IServiceManager;
+    auto sm = ::android::hardware::defaultServiceManager();
+    return sm->getTransport(descriptor, name) != IServiceManager::Transport::EMPTY;
+}
+
+Return<int32_t> DisplayColorCalibration::getMaxValue() {
+    return kMaxValue;
+}
+
+Return<int32_t> DisplayColorCalibration::getMinValue() {
+    return kMinValue;
+}
+
+Return<void> DisplayColorCalibration::getCalibration(getCalibration_cb _hidl_cb) {
+    hidl_vec<int32_t> rgb;
+    rgb.resize(user_rgb_.size());
+
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        std::copy(user_rgb_.begin(), user_rgb_.end(), rgb.begin());
+    }
+
+    _hidl_cb(rgb);
+    return Void();
+}
+
+Return<bool> DisplayColorCalibration::setCalibration(const hidl_vec<int32_t>& rgb) {
+    if (rgb.size() != user_rgb_.size()) {
+        return false;
+    }
+
+    for (auto value : rgb) {
+        if (value < kMinValue || value > kMaxValue) {
+            return false;
+        }
+    }
+
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto old_rgb = user_rgb_;
+    std::copy(rgb.begin(), rgb.end(), user_rgb_.begin());
+    if (!applyLocked()) {
+        user_rgb_ = old_rgb;
+        return false;
+    }
+    return true;
+}
+
+bool DisplayColorCalibration::isFactoryCorrectionEnabled() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return factory_correction_supported_ && factory_correction_enabled_;
+}
+
+bool DisplayColorCalibration::setFactoryCorrectionEnabled(bool enabled) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (!factory_correction_supported_) {
+        return false;
+    }
+
+    const bool old_enabled = factory_correction_enabled_;
+    factory_correction_enabled_ = enabled;
+    if (!applyLocked()) {
+        factory_correction_enabled_ = old_enabled;
+        return false;
+    }
+    return true;
+}
+
+bool DisplayColorCalibration::reapply() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return applyLocked();
+}
+
+bool DisplayColorCalibration::readFactoryCorrectionLocked(std::array<double, 3>* rgb) {
+    int32_t mode_id = -1;
+    if (controller_->getActiveDisplayMode(&mode_id) != OK) {
+        LOG(ERROR) << "Unable to determine active display mode for factory PCC";
+        return false;
+    }
+
+    const char* path = FactoryCorrectionPath(mode_id);
+    if (path == nullptr) {
+        LOG(ERROR) << "No factory PCC source for display mode " << mode_id;
+        return false;
+    }
+
+    return ParseFactoryCorrection(path, rgb);
+}
+
+bool DisplayColorCalibration::applyLocked() {
+    std::array<double, 3> factory_rgb{{1.0, 1.0, 1.0}};
+    if (factory_correction_supported_ && factory_correction_enabled_ &&
+        !readFactoryCorrectionLocked(&factory_rgb)) {
+        return false;
+    }
+
+    std::array<double, 3> composed{};
+    for (size_t i = 0; i < composed.size(); i++) {
+        const double user = static_cast<double>(user_rgb_[i]) / kMaxValue;
+        composed[i] = user * factory_rgb[i];
+    }
+
+    if (controller_->setUserColorBalance(composed[0], composed[1], composed[2]) != OK) {
+        LOG(ERROR) << "Failed to apply composed PCC correction";
+        return false;
+    }
+
+    LOG(DEBUG) << "Applied PCC: factory="
+               << (factory_correction_supported_ && factory_correction_enabled_)
+               << " user=" << user_rgb_[0] << "," << user_rgb_[1] << "," << user_rgb_[2]
+               << " composed=" << composed[0] << "," << composed[1] << "," << composed[2];
+    return true;
+}
+
+}  // namespace sdm
+}  // namespace V2_0
+}  // namespace livedisplay
+}  // namespace lineage
+}  // namespace vendor
