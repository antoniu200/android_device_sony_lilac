+
+    void setResponseFunctions(ISomcHookResponse iSomcHookResponse, ISomcHookIndication iSomcHookIndication) throws RemoteException;
+
+    @Override // android.hidl.base.V1_0.IBase
+    boolean unlinkToDeath(IHwBinder.DeathRecipient deathRecipient) throws RemoteException;
+
+    static ISomcHook asInterface(IHwBinder binder) {
+        if (binder == null) {
+            return null;
+        }
+        IHwInterface iface = binder.queryLocalInterface(kInterfaceName);
+        if (iface != null && (iface instanceof ISomcHook)) {
+            return (ISomcHook) iface;
+        }
